<hc:Window x:Class="CodeForgeDemo.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hc="https://handyorg.github.io/handycontrol"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
            xmlns:cf="clr-namespace:CodeForge;assembly=CodeForge"
            Title="CodeForge - C# 代码编辑器"
            Height="760"
            Width="1240"
            MinHeight="480"
            MinWidth="800"
            WindowStartupLocation="CenterScreen"
            WindowStyle="None"
            AllowsTransparency="False"
            ResizeMode="CanResizeWithGrip"
            Background="{DynamicResource RegionBrush}">

    <hc:Window.Resources>
        <!-- 共享图标资源（标题栏按钮用 Path） -->
        <Geometry x:Key="Geo.Play">F1M8.5 2.5L17.5 8.5L17.5 15.5L8.5 21.5L-0.5 15.5L-0.5 8.5L8.5 2.5Z</Geometry>
        <Geometry x:Key="Geo.Build">M2 2h8v2H4v4H2V2zm0 16h2v-4h4v-2H2v6zm12-16h6v14h-4v-2h2V4h-4V2zm0 12h4v4h-6v-6h2v2zm-8-8h10v2H10v6H6v-6H6zm2 2v2h6v-2H8z</Geometry>
        <Geometry x:Key="Geo.Minimize">M0 10h16v2H0z</Geometry>
        <Geometry x:Key="Geo.Maximize">M2 2h16v16H2zM4 4v12h12V4z</Geometry>
        <Geometry x:Key="Geo.Restore">M4 4h10v2H6v8h10V6h2v10H4z</Geometry>
        <Geometry x:Key="Geo.Close">M2 4 L4 2 L8 6 L12 2 L14 4 L10 8 L14 12 L12 14 L8 10 L4 14 L2 12 L6 8 Z</Geometry>
        <Geometry x:Key="Geo.Add">M7 2 h2 v5 h5 v2 h-5 v5 h-2 v-5 h-5 v-2 h5 z</Geometry>
        <Geometry x:Key="Geo.Remove">M2 7 h12 v2 h-12 z</Geometry>
        <Geometry x:Key="Geo.Library">M2 4h12v2H2V4zm0 4h12v2H2V8zm0 4h12v2H2v-2zm10-9h2v14h-2V3zM4 3h2v14H4V3z</Geometry>

        <Style x:Key="HeaderIconStyle" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <Style x:Key="SmallIconStyle" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Viewbox Width="14" Height="14">
                                <ContentPresenter x:Name="cp"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ErrorWarnItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        </Style>

        <Style x:Key="IconTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
    </hc:Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: 自定义标题栏 -->
            <RowDefinition Height="*"/>    <!-- 1: 主工作区（编辑器+MiniMap） -->
            <RowDefinition Height="Auto"/> <!-- 2: 错误列表 + 输出日志 底部面板 -->
            <RowDefinition Height="Auto"/> <!-- 3: 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ========== Row 0: 自定义标题栏（三列：左图标+标题+引用管理器按钮 | 中操作按钮+主题 | 右最小/最大/关闭；整体可拖拽） ========== -->
        <Border Grid.Row="0"
                x:Name="TitleBarBorder"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6,8,6"
                Height="40"
                hc:WindowAttach.IsDragElement="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：Logo + 标题 + 打开「程序集引用管理」按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                        <Path Data="M2 3 L2 13 L14 13 L14 3 Z M8 6 l2 2 l2 -2 l2 2 l-2 2 l2 2 l-2 -2 l-2 2 l-2 -2 l-2 2 l2 -2 l-2 -2 z"
                              Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Text="CodeForge Studio"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <!-- 【引用管理器】左侧栏已移除，改成截图风格的模态弹窗，通过标题栏按钮打开 -->
                    <Button x:Name="BtnReferenceManager"
                            Style="{StaticResource IconTextButton}"
                            Margin="20,0,4,0"
                            Click="BtnReferenceManager_Click"
                            ToolTip="程序集引用管理">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                <Path Data="{StaticResource Geo.Library}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="引用" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 中：主题 + 编译 + 运行 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="主题："
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"/>
                    <!-- 窗口 UI 主题只有白 / 黑 两档（HandyControl Skin） -->
                    <ComboBox x:Name="TitleBarSkinCombo"
                              Width="92"
                              Height="28"
                              VerticalContentAlignment="Center"
                              FontSize="12"
                              SelectionChanged="TitleBarSkinCombo_SelectionChanged">
                        <ComboBoxItem Content="亮色" Tag="Light" IsSelected="True"/>
                        <ComboBoxItem Content="暗色" Tag="Dark"/>
                    </ComboBox>

                    <TextBlock Text="代码配色："
                               VerticalAlignment="Center"
                               Margin="14,0,6,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"/>
                    <!-- 编辑器内代码字体配色主题（独立于窗口主题；对应 CodeHighlightPalette） -->
                    <ComboBox x:Name="CodeThemeCombo"
                              Width="150"
                              Height="28"
                              VerticalContentAlignment="Center"
                              FontSize="12"
                              SelectionChanged="CodeThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="经典（跟随窗口）" Tag="FollowWindow" IsSelected="True"/>
                        <ComboBoxItem Content="VS Code Dark+"  Tag="VsCodeDark"/>
                        <ComboBoxItem Content="Monokai"        Tag="Monokai"/>
                        <ComboBoxItem Content="One Dark Pro"   Tag="OneDark"/>
                        <ComboBoxItem Content="Solarized 亮色" Tag="SolarizedLight"/>
                        <ComboBoxItem Content="Solarized 暗色" Tag="SolarizedDark"/>
                        <ComboBoxItem Content="Nord"           Tag="Nord"/>
                        <ComboBoxItem Content="Tokyo Night"    Tag="TokyoNight"/>
                    </ComboBox>

                    <Button x:Name="BtnBuild"
                            Margin="18,0,4,0"
                            Click="BtnBuild_Click"
                            ToolTip="编译 (F5)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource Geo.Build}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="编译" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRun"
                            Click="BtnRun_Click"
                            ToolTip="生成并运行 (F6)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource Geo.Play}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="运行" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 脚本体编辑器示例：只写方法体（给 Result 赋值），包装代码自动生成 -->
                    <Button x:Name="BtnScriptDemo"
                            Margin="4,0,0,0"
                            Click="BtnScriptDemo_Click"
                            ToolTip="脚本编辑器示例（只写方法体，自动包装编译运行）">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource Geo.Build}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="脚本示例" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- XAML 代码提示演示：元素/属性/取值三级补全（DesignerKit XAML 编辑器预研） -->
                    <Button x:Name="BtnXamlDemo"
                            Margin="4,0,0,0"
                            Click="BtnXamlDemo_Click"
                            ToolTip="XAML 代码提示演示（元素/属性/取值三级补全）">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="{StaticResource Geo.Build}" Fill="White" Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="XAML 示例" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 右：最小化 / 最大化 / 关闭 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-2,-8,0">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}">
                        <Path Data="{StaticResource Geo.Minimize}" Style="{StaticResource HeaderIconStyle}"/>
                    </Button>
                    <Button x:Name="BtnMaxRestore" Style="{StaticResource TitleBarButton}">
                        <Path x:Name="IconMaxRestore" Data="{StaticResource Geo.Maximize}" Style="{StaticResource HeaderIconStyle}"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}">
                        <Path Data="{StaticResource Geo.Close}" Style="{StaticResource HeaderIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== Row 1: 主工作区：编辑器控件（内置鸟瞰图，ShowMiniMap 可开关） ========== -->
        <Border Grid.Row="1"
                Margin="4,4,4,2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource RegionBrush}">
            <Grid ClipToBounds="True">
                <cf:CodeEditorControl x:Name="_editor"
                                      CodeTheme="FollowWindow"
                                      EditorSkin="Light"
                                      EditorFontSize="14"
                                      EditorFontFamily="Consolas, Courier New, monospace"
                                      MinFontSize="8"
                                      MaxFontSize="48"
                                      ShowMiniMap="True"/>
            </Grid>
        </Border>

        <!-- ========== Row 2: 底部面板（错误列表 + 输出日志；截图中错误信息也是放下面显示） ========== -->
        <Grid Grid.Row="2"
              Margin="4,2,4,2"
              Height="220"
              Background="{DynamicResource RegionBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>   <!-- 左：错误/警告列表（编译错误同步：高亮行、显示信息） -->
                <ColumnDefinition Width="*"/>   <!-- 右：运行输出日志（原来的右侧输出搬过来，让横向空间给编辑器） -->
            </Grid.ColumnDefinitions>

            <!-- 左：错误 / 警告 列表（错误 / 警告 数量显示在标题上；点击某条跳到对应行） -->
            <Border Grid.Column="0"
                    Margin="0,0,2,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,4">
                        <TextBlock Text="错误列表"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="ErrorListCount"
                                   Text="（0 错误 / 0 警告）"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="ErrorListBox"
                             Grid.Row="1"
                             Margin="4,0,4,4"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ErrorWarnItemStyle}"
                             MouseDoubleClick="ErrorListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SeverityText}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding SeverityBrush}"
                                               Margin="0,0,8,0"
                                               Width="58"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Display}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右：输出日志（原来右侧的 OutputTextBox 移到这里：编译开始/结束、ConsoleOutput、ErrorMessage 都在这显示） -->
            <Border Grid.Column="1"
                    Margin="2,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,4">
                        <TextBlock Text="输出"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <Button x:Name="BtnClearOutput"
                                Margin="16,0,0,0"
                                Height="22"
                                Padding="6,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="11"
                                Content="清空"
                                Click="BtnClearOutput_Click"/>
                    </StackPanel>

                    <TextBox x:Name="OutputTextBox"
                             Grid.Row="1"
                             Margin="4,0,4,4"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== Row 3: 底部状态栏 ========== -->
        <Border Grid.Row="3"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6,12,6"
                Height="30">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</hc:Window>
