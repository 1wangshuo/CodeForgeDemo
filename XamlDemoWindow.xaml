<Window x:Class="CodeForgeDemo.XamlDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cf="clr-namespace:CodeForge;assembly=CodeForge"
        Title="XAML 代码提示演示 —— “&lt;” 出元素 | 标签内空格出属性 | 属性等号后引号里出取值（DesignerKit XAML 编辑器预研）"
        Height="760" Width="1040"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 提示条 -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Text="输入 “&lt;” 出元素；标签内空格出属性；打 “=” 直接出取值、选中自动写入 =“值”；“&gt;” 自动补闭合标签；回车自动换行——闭合标签与起始标签平齐、内容缩进一级；Ctrl+Space 随时呼出。词表为演示静态数据，正式版（DesignerKit）换程序集反射。"/>
        </Border>

        <!-- 与 C# 演示同一编辑器控件：HC 主题 / Ctrl+滚轮缩放 / 补全管线全部复用；
             XAML 模式 = SetSyntaxHighlighting("XML") + ExternalCompletionProvider 词表接管 -->
        <cf:CodeEditorControl x:Name="Editor" Grid.Row="1"/>
    </Grid>
</Window>
