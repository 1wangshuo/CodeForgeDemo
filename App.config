<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- HandyControl 统一绑定到 3.5.1：
           宿主用 NuGet 正式版 3.5.1，而部分用户脚本 DLL（如 TeamAAS.Dialogs）编译时引用了 3.6 预览版。
           CLR 对强命名程序集要求版本精确匹配，没有这条重定向会在脚本运行期抛 FileLoadException(0x80131040)。
           注意：若用户 DLL 调用了仅 3.6 新增的 API，会变成 MissingMethodException —— 那就需要该 DLL 改为引用 3.5.x 重编。 -->
      <dependentAssembly>
        <assemblyIdentity name="HandyControl" publicKeyToken="45be8712787a1e5b" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="3.5.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
